---
import Icon, { type IconName } from './Icon.astro';
import Shot from './Shot.astro';
import { screenshot } from '../lib/screenshots';

const features: { icon: IconName; title: string; text: string }[] = [
  { icon: 'database', title: 'History that stays', text: 'Every hour appended to SQLite on a second drive, with a consistent backup beside it.' },
  { icon: 'copyCheck', title: 'Counts each byte once', text: "SRUM's total row is never added to the apps' rows, and a re-run inserts nothing." },
  { icon: 'tag', title: 'Names Windows would show', text: 'Install paths, store package versions and services fold into one app each.' },
  { icon: 'merge', title: 'Your own grouping', text: 'Rename, recolour, hide or merge any app; it is stored with the history.' },
  { icon: 'wifi', title: 'Where it went', text: 'Wi-Fi against wired, every network on a ring, named as the PC sees them.' },
  { icon: 'layoutGrid', title: 'Table or grid', text: 'Every app in a sortable table, or as cards with its logo large.' },
  { icon: 'smartphone', title: 'Phones too', text: 'Each phone gets the same pages, with tethering kept out of its totals.' },
  { icon: 'rotateCcw', title: 'Survives a reset', text: '<code>npm run restore</code> puts it back; <code>npm run drill</code> rehearses it.' },
];
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Features</p>
      <h2 id="features-title">Windows' own numbers, kept.</h2>
      <p class="lead">It reads what Windows and Android already record, checks it against their own pages, and keeps every day.</p>
    </div>
    <ul class="grid features">
      {
        features.map((f) => (
          <li class="card">
            <span class="icon-tile"><Icon name={f.icon} /></span>
            <h3>{f.title}</h3>
            <p class="muted" set:html={f.text} />
          </li>
        ))
      }
    </ul>
    <figure class="grid-shot">
      <Shot
        class="frame"
        shot={screenshot('windows-apps-grid')}
        alt="By App as a grid: one card per app with its logo, total, upload and download, and active days"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1180px) 1040px, calc(100vw - 48px)"
      />
      <figcaption>By App as a grid. Every number shown is invented.</figcaption>
    </figure>
  </div>
</section>

<style>
  .features {
    --col-min: 240px;
    padding: 0;
    list-style: none;
  }

  .features h3 {
    margin-bottom: 6px;
  }

  .features p {
    font-size: 0.9375rem;
  }

  .grid-shot {
    margin: clamp(32px, 5vw, 56px) 0 0;
  }

  /* The capture is the whole page; the frame shows its Apps card, which
     starts about 37% of the way down, below the Top 10 chart. */
  .grid-shot :global(img) {
    aspect-ratio: 16 / 10;
    height: auto;
    object-fit: cover;
    object-position: 50% 63%;
  }

  .grid-shot figcaption {
    margin-top: 16px;
    color: var(--text-faint);
    font-size: 0.875rem;
  }
</style>
