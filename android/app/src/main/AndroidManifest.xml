<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PACKAGE_USAGE_STATS is the permission that makes this app possible.
      Without it, NetworkStatsManager returns only this app's OWN traffic, which
      looks exactly like the app working. It cannot be granted by a runtime
      prompt: the user switches it on in Settings, Special app access, Usage
      access, which MainActivity links to directly. tools:ignore is here because
      the linter flags it as not normally grantable, which is precisely why the
      app has to walk the user to that screen.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      READ_PHONE_STATE, on Android 9 and older ONLY. Below API 29,
      NetworkStatsManager cannot be asked for "every SIM": a null subscriber id
      matches no mobile traffic at all, and returns zero rather than failing.
      So UsageReader asks for each SIM's subscriber id, which needs this.
      maxSdkVersion keeps it off every newer phone, where it is not needed and
      would be a prompt for nothing.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        android:maxSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- So the periodic job comes back after a reboot instead of waiting for
         the app to be opened again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      QUERY_ALL_PACKAGES. Android 11+ hides the package list by default, and
      this app's whole job is to name every uid that moved bytes, including apps
      it has no relationship with. A queries element cannot express "all of
      them", so this is the only option.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:label="Data Usage Reporter"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Data Usage Reporter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SyncJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
