# Copy to .env.local (which is gitignored) and set a password.
#
# The dashboard refuses every request until this is set - it fails closed, so a
# missing value locks the door rather than opening it.
#
# It serves a detailed record of which programs run on this machine and when,
# and with DASHBOARD_HOST set (below) it is reachable from your whole network.
#
# At least 12 characters. A shorter one fails closed too: the dashboard stays
# locked and the login page says why. Wrong guesses are throttled (10 a minute,
# then a lockout that doubles), which only helps if the password is long.
#
# Rotating the password invalidates all existing sessions, because the session
# cookie is signed with a key derived from it. Restart the server after changing it.
DASHBOARD_PASSWORD=

# Which network interface the dashboard listens on. Unset, it is 127.0.0.1:
# only this machine can open it. The Android reporter uploads over the LAN, so
# if you use it -- or want to open the dashboard from another device -- set:
#
#   DASHBOARD_HOST=0.0.0.0
#
# and allow Node.js through Windows Firewall on PRIVATE networks only. The site
# is plain HTTP behind the password above, so do not expose it on networks you
# do not trust.
DASHBOARD_HOST=

# The Android reporter authenticates with this instead, sent as a bearer token.
# Separate from the password on purpose: the phone has no login form, and a
# device that leaves the house should not carry the dashboard password. It fails
# closed too - with no value set, /api/android/ingest refuses every request.
#
# It is stored ON THE PHONE. Change it and the app must be updated by hand, or
# it goes on syncing to a 401 and only its own status line says so.
ANDROID_INGEST_TOKEN=
